# ============================================================
# 智学 Agent（EduPi）生产环境配置 · 模板
# 用法：  cp deploy/env.prod.example server/.env   然后填入真实值
# 说明：  server/.env 已被 .gitignore 忽略，不会进版本库。
#         compose 通过 env_file 把本文件注入容器，应用直接读 process.env.*。
#         镜像里不含 .env，密钥只在运行时由 env_file 注入，安全。
# ============================================================

# ---------- 运行模式 ----------
NODE_ENV=production
PORT=3000

# ---------- 大模型（必填）----------
# OpenAI 兼容或 Anthropic 端点，例如 https://api.openai.com/v1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# 视觉/兜底能力（资料 OCR、图片问答需要）：1 开启 / 0 关闭
LLM_VISION=1

# ---------- 检索（RAG 资料问答，必填）----------
EMBEDDING_MODEL=text-embedding-v4
RERANK_MODEL=gte-rerank-v2

# ---------- 外部 Milvus 向量库（必填，应用连外部实例）----------
# 格式 host:port；与云服务器同 VPC 时优先用内网地址，例如 10.0.0.x:19530
MILVUS_ADDRESS=
# 若外部 Milvus 开启认证则填写，否则留空
MILVUS_USERNAME=
MILVUS_PASSWORD=
MILVUS_TOKEN=
MILVUS_TIMEOUT_MS=15000

# ---------- 安全主密钥（必填，生产必须显式配置并备份）----------
# 用于加密模型密钥 / MCP 配置。生成：  openssl rand -hex 32
EDUPI_SETTINGS_SECRET=

# ---------- 认证与注册 ----------
AUTH_ENABLED=1
# 公网直连建议先关闭公开注册，改由管理员建号，避免被滥用于消耗你的 LLM 额度
REGISTRATION_OPEN=0
REGISTER_MAX_PER_HOUR=10
# 首个管理员仅本机/容器内可创建（默认 1）；部署时由容器内执行 bootstrap，符合限制
BOOTSTRAP_LOCAL_ONLY=1
CSRF_ENABLED=1
SESSION_TTL_DAYS=7
SESSION_ABSOLUTE_DAYS=30

# ---------- 反向代理 / Cookie ----------
TRUST_PROXY=1
# 直连 IP:端口为 HTTP（无 HTTPS）：留 auto 即可（HTTP 下不置 Secure Cookie）
COOKIE_SECURE=auto

# ---------- 首次管理员（供部署脚本自动 bootstrap，可选但建议填）----------
AUTH_BOOTSTRAP_USER=admin
AUTH_BOOTSTRAP_PASSWORD=
AUTH_BOOTSTRAP_DISPLAY=管理员

# ---------- 数据与存储 ----------
EDU_DATA_DIR=/app/data
STORAGE_QUOTA_MB=1024

# ---------- 多用户运行护栏 ----------
# 同一会话固定使用一个 key，失败才切换；候选数上限
LLM_KEY_MAX_ATTEMPTS=3
# Pi AgentSession 缓存上限与空闲过期（分钟）
AGENT_SESSION_MAX=300
AGENT_SESSION_TTL_MIN=60
# 聊天并发：全局 / 单用户；全局满时最长排队毫秒数
AGENT_MAX_CONCURRENT=6
AGENT_MAX_CONCURRENT_PER_USER=2
AGENT_QUEUE_WAIT_MS=15000
# 运行时表清理
MAINTENANCE_INTERVAL_HOURS=6
IDEMPOTENCY_RETENTION_HOURS=24
TASK_RETENTION_DAYS=30

# 注意：server/.env 含模型密钥，部署后执行 chmod 600 server/.env
# 首次管理员创建后请删除 AUTH_BOOTSTRAP_PASSWORD

# ---------- 扫描件 OCR（可选）----------
# 未部署 docling-serve 时走视觉模型兜底；auto 会先试 docling 再 vision
# OCR_ENGINE=auto

# ---------- 服务端 TTS（可选，不填则用浏览器 TTS）----------
# TTS_BASE_URL=
# TTS_API_KEY=
# TTS_MODEL=
# TTS_VOICE=alloy
