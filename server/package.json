{
  "name": "server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --watch-path=src --import jiti/register src/index.ts",
    "start": "node --import jiti/register src/index.ts",
    "auth:bootstrap": "node --import jiti/register scripts/auth-bootstrap.ts",
    "auth:reset": "node --import jiti/register scripts/auth-reset.ts",
    "user:create": "node --import jiti/register scripts/user-create.ts",
    "auth:check": "node --import jiti/register scripts/check-auth.ts",
    "auth:isolation": "node --import jiti/register scripts/check-isolation.ts",
    "auth:migrate": "node --import jiti/register scripts/auth-migrate.ts",
    "asr:model": "node --import jiti/register scripts/fetch-asr-model.ts",
    "backup": "node --import jiti/register scripts/backup.ts",
    "auth:admin-check": "node --import jiti/register scripts/check-admin.ts",
    "bench:s23": "node --import jiti/register scripts/bench-s23.ts",
    "check:multiuser": "node --import jiti/register scripts/check-multiuser.ts",
    "check:pinning": "node --import jiti/register scripts/check-session-pinning.ts",
    "check:lock": "node --import jiti/register scripts/check-conversation-lock.ts",
    "check:gate": "node --import jiti/register scripts/check-chat-gate.ts",
    "check:multiuser:all": "node --import jiti/register scripts/check-multiuser.ts && node --import jiti/register scripts/check-session-pinning.ts && node --import jiti/register scripts/check-conversation-lock.ts && node --import jiti/register scripts/check-chat-gate.ts",
    "check:viz": "node --import jiti/register scripts/check-viz-plan.ts && node --import jiti/register scripts/check-viz-render.ts && node --import jiti/register scripts/check-viz-snapshots.ts",
    "check:viz:snapshots": "node --import jiti/register scripts/check-viz-snapshots.ts",
    "migrate:viz": "node --import jiti/register scripts/migrate-viz-v2.ts"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^1.5.0",
    "@hono/node-server": "^1.13.7",
    "@hono/node-ws": "^1.3.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@napi-rs/canvas": "^1.1.0",
    "@zilliz/milvus2-sdk-node": "^3.0.6",
    "gray-matter": "^4.0.3",
    "hono": "^4.6.14",
    "iconv-lite": "^0.7.3",
    "jiti": "^2.4.2",
    "mammoth": "^1.13.0",
    "pdfjs-dist": "^6.5.438",
    "sherpa-onnx-node": "^2.0.1",
    "typebox": "^1.3.27",
    "word-extractor": "^1.0.4"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.7.2"
  }
}
